# Marshal FE — environment variables.
# Copy to `.env.development` / `.env.production` (or `.env.<mode>.local`) as needed.

VITE_API_BASE_URL=/api/v1
VITE_MOCK_MODE=true
VITE_APP_TITLE=Marshal Control Tower
VITE_POLL_INTERVAL_MS=5000

# SSE flow-event source. Defaults to {VITE_API_BASE_URL}/events.
# Local run without marshal_api: use the marshal_ai dashboard (:8090) through the dev proxy.
# VITE_EVENTS_URL=/events
