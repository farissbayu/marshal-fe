# Optional. Without any key, the whole app runs with deterministic offline AI
# (every AI event is flagged `degraded: true`), and batches still finish `done`.
GOOGLE_GENAI_API_KEY=

# Or use Vertex AI instead of an API key:
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-southeast1

# Model used by all AI tasks.
GEMINI_MODEL=gemini-2.5-flash
